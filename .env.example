# SupplyPilot authentication server (FastAPI; Node.js 24+ for the legacy fallback)
AUTH_PORT=3002
AUTH_DB_PATH="./data/auth.sqlite"
# Import batches, records, rules and quality history.
DATA_DB_PATH="./data/supply.sqlite"
AUTH_SECRET="replace-with-a-long-random-secret"
# Set when the API is hosted separately from the frontend.
# VITE_AUTH_API_BASE_URL="https://your-api.example.com"
# Set only for a separately hosted frontend; use HTTPS with cross-site cookies.
# FRONTEND_ORIGIN="https://your-frontend.example.com"
# AUTH_CROSS_SITE_COOKIE=true

# Email verification
SMTP_URL="smtps://username:password@smtp.example.com:465"
SMTP_FROM="Scope <no-reply@example.com>"
# Optional: keep the SMTP password here instead of embedding it in SMTP_URL.
SMTP_PASSWORD=""

# SMS verification via Twilio (phone numbers must be in E.164 format)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# WeChat website QR login; callback must reach /api/auth/wechat/callback
# Local Python backend only; disabled in production. Use localhost to access.
WECHAT_MOCK_LOGIN="false"
WECHAT_APP_ID=""
WECHAT_APP_SECRET=""
WECHAT_REDIRECT_URI="https://your-domain.example.com/api/auth/wechat/callback"

# PostgreSQL is required for scenario calculations and risk monitoring.
# Login and file import can still start without it; S3 is only historical storage.
# Keep existing .env values when retaining historical archives.
ANALYST_DATABASE_URL="postgresql://scope_app:replace-me@127.0.0.1:55432/scope_analyst"
# Single-process risk scheduler; default scans each configured scenario every 60s.
SUPPLY_MONITOR_AUTOSTART="1"
# Investigation defaults to deterministic tools. Opt in to model tool calls explicitly.
SUPPLY_INVESTIGATOR="rules"
# Dedicated scoped read-only login; install with python -m backend.install_investigation_sql --local.
# SUPPLY_AGENT_DATABASE_URL="postgresql://scope_agent_reader:replace-me@127.0.0.1:55432/scope_analyst"
SUPPLY_AGENT_MAX_ROUNDS=12
SUPPLY_AGENT_MAX_SECONDS=120
SUPPLY_AGENT_MAX_TOKENS=24000
# Automatic linked investigations after rejection/invalidation: 0 disables, maximum 5.
SUPPLY_MAX_REPLANS=3
# SUPPLY_INVESTIGATOR="model"
# SUPPLY_MODEL="your-tool-capable-model"
# SUPPLY_MODEL_BASE_URL="https://api.deepseek.com"
# SUPPLY_MODEL_API_KEY=""
# LangGraph checkpoints are stored beside DATA_DB_PATH in supply-graph.sqlite.
# Run one backend process; back up the local databases and PostgreSQL together.
ANALYST_S3_ENDPOINT="http://127.0.0.1:19000"
ANALYST_S3_REGION="us-east-1"
ANALYST_S3_BUCKET="scope-artifacts"
ANALYST_S3_ACCESS_KEY=""
ANALYST_S3_SECRET_KEY=""
